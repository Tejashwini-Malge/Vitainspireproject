# Copy to backend/.env for local development. Never commit .env.
# Use a database name that makes its purpose obvious. Tests refuse any database not named *_test.
VITA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/vitainspire_dev
# Private document storage. Must be outside the repository and never inside a web-served folder.
VITA_STORAGE_DIR=/absolute/path/outside/the/repo/vita-storage
VITA_SESSION_TTL_HOURS=168
VITA_MAX_UPLOAD_BYTES=10485760
